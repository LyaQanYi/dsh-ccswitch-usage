{
  "name": "dsh-ccswitch-usage",
  "displayName": "DSH → CC Switch Usage",
  "description": "把 DeepSeek Harness 每次模型调用消耗的 token 记进 CC Switch 的用量统计（app_type=dsh），在 CC Switch 用量面板里与其它 CLI 一起看。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cc-switch",
    "ccswitch",
    "usage",
    "tokens"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js",
    "smoke": "node scripts/smoke.mjs",
    "dry-run": "node scripts/dry-run.mjs",
    "edge-cases": "node scripts/edge-cases.mjs",
    "concurrency": "node scripts/concurrency.mjs",
    "cordis-mount": "ELECTRON_RUN_AS_NODE=1 '/Applications/DeepSeek Harness.app/Contents/MacOS/DeepSeek Harness' --expose-internals scripts/cordis-mount.mjs"
  },
  "author": "浅忆QanYi (LyaQanYi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyaQanYi/dsh-ccswitch-usage.git"
  },
  "homepage": "https://github.com/LyaQanYi/dsh-ccswitch-usage#readme",
  "bugs": {
    "url": "https://github.com/LyaQanYi/dsh-ccswitch-usage/issues"
  }
}
